# Copy to .env and adjust. Any SQLAlchemy URL works:
#   SQLite (default, zero setup):  sqlite:///./wms.db
#   PostgreSQL (recommended):      postgresql+psycopg://user:password@host:5432/wms
#   MySQL / MariaDB:               mysql+pymysql://user:password@host:3306/wms   (pip install pymysql)
#   SQL Server:                    mssql+pyodbc://user:password@dsn               (pip install pyodbc)
WMS_DATABASE_URL=sqlite:///./wms.db

# REQUIRED in production: long random string used to sign login tokens
WMS_SECRET_KEY=change-me-to-a-long-random-string
WMS_TOKEN_TTL_HOURS=12

# Initial admin account (created only when the users table is empty)
WMS_ADMIN_USERNAME=admin
WMS_ADMIN_PASSWORD=admin

# Seed a demo warehouse, items, stock and orders on first start against an empty DB
WMS_SEED_DEMO_DATA=true

WMS_APP_NAME=Dockyard WMS
WMS_CORS_ORIGINS=http://localhost:5173

# Address external systems (e.g. a robotics platform) use to call back into the WMS.
# Included in outbound event payloads as callbacks.confirm_tasks.
WMS_PUBLIC_URL=http://localhost:8000
# Background delivery of outbound integration messages (keep true; run a single app process)
WMS_DISPATCHER_ENABLED=true
WMS_DISPATCH_INTERVAL_SECONDS=2

# Mock picking system (docs/MOCK_PICKING.md). Set a key before exposing it through the tunnel;
# the SOFTBOT then sends it as header x-api-key, and the messages page opens as /?key=<key>
MOCK_PICKING_API_KEY=
